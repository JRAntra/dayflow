{
  "name": "dayflow",
  "productName": "DayFlow",
  "version": "0.1.0-beta.4",
  "description": "A local desktop day planner that reminds you when each phase of your day starts and ends, plus Google Calendar meeting reminders.",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/dev.js",
    "dist": "electron-builder --publish never",
    "icons": "electron scripts/build-icons.js",
    "dist:legacy": "electron-builder --mac --publish never -c.electronVersion=37.10.3 -c.mac.minimumSystemVersion=11.0 -c.directories.output=dist/legacy '-c.mac.artifactName=DayFlow-${version}-macos11-${arch}.${ext}' '-c.dmg.artifactName=DayFlow-${version}-macos11-${arch}.${ext}' '-c.dmg.title=DayFlow ${version} (macOS 11+)'"
  },
  "dependencies": {
    "@fontsource/sora": "5.3.0",
    "google-auth-library": "11.3.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.dayflow.app",
    "productName": "DayFlow",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "DayFlow-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "DayFlow uses the microphone only when you record a clip."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "dmg": {
      "title": "DayFlow ${version}",
      "artifactName": "DayFlow-${version}-${arch}.${ext}"
    }
  }
}
